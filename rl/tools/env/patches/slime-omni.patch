+def get_updatable_server_engines(server, *, with_meta: bool = False):
+    """Return updatable engines for *server*, excluding encoder-only EPD groups.
+
+    When *with_meta* is False, returns only live (non-None) engines.
+    When *with_meta* is True, returns ``(engines, num_new, gpu_counts, gpu_offsets, parallel_configs)``.
+    """
+    if server is None:
+        return ([], 0, [], [], []) if with_meta else []
+    if not hasattr(server, "server_groups"):
+        if not with_meta:
+            return [e for e in server.engines if e is not None]
+        return (
+            server.engines,
+            server.num_new_engines,
+            server.engine_gpu_counts,
+            server.engine_gpu_offsets,
+            server.engine_parallel_configs,
+        )
+    groups = [g for g in server.server_groups if g.worker_type != "encoder"]
+    engines = [e for g in groups for e in g.engines]
+    if not with_meta:
+        return [e for e in engines if e is not None]
+    return (
+        engines,
+        sum(g.num_new_engines for g in groups),
+        [g.num_gpus_per_engine for g in groups for _ in g.engines],
+        [g.gpu_offset + i * g.num_gpus_per_engine for g in groups for i in range(len(g.engines))],
+        [g.parallel_config() for g in groups for _ in g.engines],
+    )
+
